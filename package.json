{
  "name": "@stdiobus/mcpx",
  "version": "1.0.0",
  "description": "Universal modular launcher for MCP servers — TypeScript CLI",
  "type": "module",
  "bin": {
    "mcpx": "bin/mcpx"
  },
  "main": "./out/dist/index.js",
  "module": "./out/dist/index.js",
  "types": "./out/tsc/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./out/tsc/index.d.ts",
        "default": "./out/dist/index.js"
      },
      "require": {
        "types": "./out/tsc/index.d.ts",
        "default": "./out/dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "npm run build:clean && npm run build:bundle && npm run build:types",
    "build:clean": "node -e \"require('node:fs').rmSync('out',{recursive:true,force:true})\"",
    "build:bundle": "node scripts/run-esbuild.mjs",
    "build:types": "tsc --project tsconfig.build.json",
    "build:watch": "node scripts/run-esbuild.mjs --watch",
    "prebuild": "npm run typecheck",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "test:unit": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --testPathPattern=\"src/(cli|core|platform|runtimes)/.*\\\\.test\\\\.ts$\"",
    "pretest:property": "npm run build",
    "test:property": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --testPathPattern=properties",
    "pretest:integration": "npm run build",
    "test:integration": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --testPathPattern=integration",
    "pretest:e2e": "npm run build",
    "test:e2e": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --testPathPattern=e2e",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:mcp-e2e": "node scripts/smoke-mcp-e2e.mjs",
    "pretest:system": "npm run build",
    "test:system": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --testPathPattern=system",
    "test:all": "npm run test:unit && npm run test:property && npm run test:integration && npm run test:e2e && npm run test:system",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "author": "Raman Marozau <raman@stdiobus.com> (https://stdiobus.com)",
  "license": "Apache-2.0",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai",
    "launcher",
    "mcpx",
    "stdio",
    "module-system",
    "runtime",
    "stdiobus"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "out/",
    "bin/"
  ],
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.12",
    "fast-check": "^4.7.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
